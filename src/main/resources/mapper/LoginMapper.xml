<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.manage.customerManage.login.dao.LoginDao">

    <select id="findUser" resultType="com.manage.customerManage.login.dto.User">
        SELECT user_id,name
        FROM users
        WHERE user_id = #{userId}
        AND password = #{password}
    </select>

</mapper>